GCP_PROJECT_ID=keen-tokenizer-509013-c5
# Absolute path to the service account key, stored OUTSIDE this repo
GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\gcp-sa.json
PORT=3000

# TELUS SSO (OpenID Connect)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPE=openid profile email
# Long random string used to sign session cookies
SESSION_SECRET=
# AUTH_DISABLED=true

# TELUS portal session (Puppeteer)
PORTAL_URL=
# BROWSER_PATH=
# PORTAL_PROXY_SERVER=

# Search keys and their display labels. Leave GITHUB_REPO empty to use the local file backend/config.local.json
# (or config.example.json if that does not exist). Set it to read the same format from GitHub instead.
GITHUB_REPO=
GITHUB_CONFIG_PATH=apptrigger-config.json
GITHUB_BRANCH=main
# Needed for a private repo: a token with read access to that repo's contents
GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
# GITHUB_CONFIG_TTL_SECONDS=300

# The frontend is a separate service. Where it is served from (comma separated for several):
# leave empty when the page and this API share an address (for example the Vite dev proxy).
FRONTEND_ORIGIN=
# Where to send people after sign-in / sign-out (default: the first FRONTEND_ORIGIN)
FRONTEND_URL=
# Sign-in cookie: lax when the frontend and API are on the same site, none when they are on different sites (needs https)
SESSION_SAMESITE=lax
