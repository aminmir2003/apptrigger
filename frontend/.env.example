# Address of the backend API, set when the page is built (npm run build).
# Leave empty when the page and the API share an address (the dev proxy / npm run preview forward to API_PROXY_TARGET).
VITE_API_URL=

# Dev only: where "npm run dev" and "npm run preview" forward API calls (default http://localhost:3000)
# API_PROXY_TARGET=http://localhost:3000
